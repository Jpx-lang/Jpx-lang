# validator.jpx - Module untuk validasi data (ditulis dalam JPX)
# Akan di-import oleh main.jpx

# Validasi email sederhana: cek ada @ dan .
function isEmail(s) {
    global [hasAt = false];
    global [hasDot = false];
    global [i = 0];
    while i < len(s) {
        if s[i] == "@" {
            global [hasAt = true];
        }
        if s[i] == "." {
            global [hasDot = true];
        }
        global [i = i + 1];
    }
    if hasAt and hasDot {
        return true;
    }
    return false;
}

# Validasi panjang string minimal
function minLength(s, n) {
    if len(s) >= n {
        return true;
    }
    return false;
}

# Validasi panjang string maksimal
function maxLength(s, n) {
    if len(s) <= n {
        return true;
    }
    return false;
}

# Validasi apakah string hanya berisi huruf
function isAlpha(s) {
    if len(s) == 0 {
        return false;
    }
    global [i = 0];
    while i < len(s) {
        global [c = s[i]];
        global [code = ord(c)];
        # A-Z (65-90) atau a-z (97-122)
        if code >= 65 {
            if code <= 90 {
                # OK, lanjut
            } else {
                if code >= 97 {
                    if code <= 122 {
                        # OK, lanjut
                    } else {
                        return false;
                    }
                } else {
                    return false;
                }
            }
        } else {
            return false;
        }
        global [i = i + 1];
    }
    return true;
}

# Validasi range angka
function inRange(n, min_val, max_val) {
    if n >= min_val {
        if n <= max_val {
            return true;
        }
    }
    return false;
}
