# mini_interp.jpx - Mini interpreter (calculator) yang ditulis dalam JPX
# Bisa evaluate arithmetic: + - * / % ( ) dengan precedence
#
# Test: "(1 + 2) * 3 - 4 / 2"  →  7.0
#
# Ini proof-of-concept self-hosting: parser + evaluator ditulis di JPX sendiri.

# ============================================================
# LEXER - tokenize string jadi list of token
# ============================================================

function isDigit(c) {
    if c == "0" { return true; }
    if c == "1" { return true; }
    if c == "2" { return true; }
    if c == "3" { return true; }
    if c == "4" { return true; }
    if c == "5" { return true; }
    if c == "6" { return true; }
    if c == "7" { return true; }
    if c == "8" { return true; }
    if c == "9" { return true; }
    return false;
}

function isSpace(c) {
    if c == " " { return true; }
    if c == "\t" { return true; }
    return false;
}

function tokenize(src) {
    global [tokens = []];
    global [i = 0];
    while i < len(src) {
        global [c = src[i]];
        if isSpace(c) {
            global [i = i + 1];
        } else {
            if isDigit(c) {
                # Baca angka multi-digit
                global [num = ""];
                while i < len(src) {
                    if isDigit(src[i]) {
                        global [num = num + src[i]];
                        global [i = i + 1];
                    } else {
                        break;
                    }
                }
                global [tokens = tokens + [["NUM", int(num)]]];
            } else {
                if c == "+" {
                    global [tokens = tokens + [["OP", "+"]]];
                } else {
                    if c == "-" {
                        global [tokens = tokens + [["OP", "-"]]];
                    } else {
                        if c == "*" {
                            global [tokens = tokens + [["OP", "*"]]];
                        } else {
                            if c == "/" {
                                global [tokens = tokens + [["OP", "/"]]];
                            } else {
                                if c == "%" {
                                    global [tokens = tokens + [["OP", "%"]]];
                                } else {
                                    if c == "(" {
                                        global [tokens = tokens + [["LP", "("]]];
                                    } else {
                                        if c == ")" {
                                            global [tokens = tokens + [["RP", ")"]]];
                                        } else {
                                            print "Unknown char: " + c;
                                            return [];
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                global [i = i + 1];
            }
        }
    }
    global [tokens = tokens + [["EOF", null]]];
    return tokens;
}

# ============================================================
# PARSER - recursive descent: expr → term ± term, term → factor */ factor
# ============================================================
# Karena JPX belum punya cara bikin struct/record, kita pakai nested list:
# ["num", 42]
# ["binop", "+", left_node, right_node]

function parseExpr(tokens, pos) {
    # expr = term (('+' | '-') term)*
    global [left = null];
    global [right = null];
    global [p = pos];
    left = parseTerm(tokens, p);
    if left[0] == "error" { return left; }
    p = left[1];

    global [result = left];
    while p < len(tokens) {
        global [tok = tokens[p]];
        if tok[0] == "OP" {
            if tok[1] == "+" {
                global [p = p + 1];
                right = parseTerm(tokens, p);
                if right[0] == "error" { return right; }
                p = right[1];
                # Build new node
                result = ["ok", p, ["binop", "+", result[2], right[2]]];
            } else {
                if tok[1] == "-" {
                    global [p = p + 1];
                    right = parseTerm(tokens, p);
                    if right[0] == "error" { return right; }
                    p = right[1];
                    result = ["ok", p, ["binop", "-", result[2], right[2]]];
                } else {
                    break;
                }
            }
        } else {
            break;
        }
    }
    return result;
}

function parseTerm(tokens, pos) {
    # term = factor (('*' | '/' | '%') factor)*
    global [p = pos];
    global [left = parseFactor(tokens, p)];
    if left[0] == "error" { return left; }
    p = left[1];

    global [result = left];
    while p < len(tokens) {
        global [tok = tokens[p]];
        if tok[0] == "OP" {
            if tok[1] == "*" or tok[1] == "/" or tok[1] == "%" {
                global [op = tok[1]];
                global [p = p + 1];
                right = parseFactor(tokens, p);
                if right[0] == "error" { return right; }
                p = right[1];
                result = ["ok", p, ["binop", op, result[2], right[2]]];
            } else {
                break;
            }
        } else {
            break;
        }
    }
    return result;
}

function parseFactor(tokens, pos) {
    global [p = pos];
    if p >= len(tokens) {
        return ["error", p, "unexpected end"];
    }
    global [tok = tokens[p]];

    if tok[0] == "NUM" {
        return ["ok", p + 1, ["num", tok[1]]];
    }

    if tok[0] == "LP" {
        global [p = p + 1];
        global [inner = parseExpr(tokens, p)];
        if inner[0] == "error" { return inner; }
        p = inner[1];
        # Expect RP
        if p >= len(tokens) {
            return ["error", p, "missing )"];
        }
        if tokens[p][0] != "RP" {
            return ["error", p, "expected )"];
        }
        return ["ok", p + 1, inner[2]];
    }

    if tok[0] == "OP" and tok[1] == "-" {
        # Unary minus
        global [p = p + 1];
        global [operand = parseFactor(tokens, p)];
        if operand[0] == "error" { return operand; }
        return ["ok", operand[1], ["unary", "-", operand[2]]];
    }

    return ["error", p, "unexpected token"];
}

# ============================================================
# EVALUATOR - traverse AST dan hitung hasilnya
# ============================================================

function evaluate(node) {
    if node[0] == "num" {
        return node[1];
    }
    if node[0] == "unary" {
        global [v = evaluate(node[2])];
        return 0 - v;
    }
    if node[0] == "binop" {
        global [op = node[1]];
        global [l = evaluate(node[2])];
        global [r = evaluate(node[3])];
        if op == "+" { return l + r; }
        if op == "-" { return l - r; }
        if op == "*" { return l * r; }
        if op == "/" {
            if r == 0 {
                print "Error: division by zero";
                return 0;
            }
            return l / r;
        }
        if op == "%" { return l % r; }
        print "Unknown op: " + op;
        return 0;
    }
    print "Unknown node: " + node[0];
    return 0;
}

# ============================================================
# MAIN - public function
# ============================================================

function evalArithmetic(src) {
    global [tokens = tokenize(src)];
    if len(tokens) == 1 {
        print "Empty expression";
        return 0;
    }
    global [result = parseExpr(tokens, 0)];
    if result[0] == "error" {
        print "Parse error at pos " + result[1] + ": " + result[2];
        return 0;
    }
    return evaluate(result[2]);
}

# ============================================================
# TEST
# ============================================================

print "=== MINI INTERPRETER (in JPX) ===";
print "";

global [tests = [
    ["1 + 2", 3],
    ["3 + 4 * 2", 11],
    ["(1 + 2) * 3", 9],
    ["10 - 3 - 2", 5],
    ["100 / 4", 25],
    ["17 % 5", 2],
    ["2 * 3 + 4 * 5", 26],
    ["(2 + 3) * (4 + 5)", 45],
    ["-5 + 10", 5],
    ["2 * -3", -6]
]];

global [passed = 0];
global [failed = 0];
global [i = 0];

while i < len(tests) {
    global [t = tests[i]];
    global [src = t[0]];
    global [expected = t[1]];
    global [actual = evalArithmetic(src)];

    if actual == expected {
        print "  PASS  " + src + " = " + actual;
        global [passed = passed + 1];
    } else {
        print "  FAIL  " + src + " (expected " + expected + ", got " + actual + ")";
        global [failed = failed + 1];
    }
    global [i = i + 1];
}

print "";
print "Result: " + passed + " passed, " + failed + " failed";

if failed == 0 {
    print "ALL TESTS PASSED";
} else {
    print "SOME TESTS FAILED";
}
