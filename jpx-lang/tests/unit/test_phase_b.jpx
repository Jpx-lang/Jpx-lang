# test_phase_b.jpx - Test Phase B: Class support + modular structure

global [passed = 0];
global [failed = 0];

function ok(name, actual, expected) {
    if actual == expected {
        global [passed = passed + 1];
        print "  PASS  " + name;
    } else {
        global [failed = failed + 1];
        print "  FAIL  " + name + " (expected " + expected + ", got " + actual + ")";
    }
}

print "=== CLASS: BASIC ===";

class Point {
    __init__(self, x, y) {
        self.x = x;
        self.y = y;
    }

    getX(self) {
        return self.x;
    }

    getY(self) {
        return self.y;
    }

    toString(self) {
        return "(" + self.x + "," + self.y + ")";
    }
}

global [p = Point(3, 4)];
ok("p.x", p.x, 3);
ok("p.y", p.y, 4);
ok("p.getX()", p.getX(), 3);
ok("p.getY()", p.getY(), 4);
ok("p.toString()", p.toString(), "(3,4)");

print "";
print "=== CLASS: MUTABLE STATE ===";

class Counter {
    __init__(self, start) {
        self.count = start;
    }

    inc(self) {
        self.count = self.count + 1;
        return self.count;
    }

    dec(self) {
        self.count = self.count - 1;
        return self.count;
    }

    val(self) {
        return self.count;
    }
}

global [c = Counter(10)];
ok("initial", c.val(), 10);
ok("inc", c.inc(), 11);
ok("inc", c.inc(), 12);
ok("inc", c.inc(), 13);
ok("dec", c.dec(), 12);
ok("val", c.val(), 12);

print "";
print "=== CLASS: MULTIPLE INSTANCES ===";

class Animal {
    __init__(self, name, sound) {
        self.name = name;
        self.sound = sound;
    }

    speak(self) {
        return self.name + " says " + self.sound;
    }
}

global [dog = Animal("Dog", "Woof")];
global [cat = Animal("Cat", "Meow")];
ok("dog.name", dog.name, "Dog");
ok("cat.name", cat.name, "Cat");
ok("dog.speak()", dog.speak(), "Dog says Woof");
ok("cat.speak()", cat.speak(), "Cat says Meow");

# Mutate field
dog.sound = "Bark";
ok("dog.sound mutated", dog.speak(), "Dog says Bark");

print "";
print "=== CLASS: METHOD CALLING OTHER METHOD ===";

class Calculator {
    __init__(self) {
        self.result = 0;
    }

    add(self, x) {
        self.result = self.result + x;
        return self;
    }

    multiply(self, x) {
        self.result = self.result * x;
        return self;
    }

    get(self) {
        return self.result;
    }
}

global [calc = Calculator()];
calc.add(5);
calc.add(3);
calc.multiply(2);
ok("chain", calc.get(), 16);

print "";
print "=== CLASS: COMBINED WITH PHASE A ===";

class Stack {
    __init__(self) {
        self.items = [];
    }

    push(self, item) {
        self.items = self.items + [item];
    }

    peek(self) {
        if len(self.items) == 0 {
            return null;
        }
        return self.items[len(self.items) - 1];
    }

    size(self) {
        return len(self.items);
    }
}

global [stack = Stack()];
stack.push(1);
stack.push(2);
stack.push(3);
ok("stack size", stack.size(), 3);
ok("peek 3", stack.peek(), 3);

print "";
print "=== CLASS: WITH STRING METHODS ===";

class TextProcessor {
    __init__(self, text) {
        self.text = text;
    }

    words(self) {
        return self.text.split(" ");
    }

    upper(self) {
        return self.text.upper();
    }

    count(self, sub) {
        return self.text.count(sub);
    }
}

global [tp = TextProcessor("the quick brown fox")];
ok("words count", len(tp.words()), 4);
ok("upper", tp.upper(), "THE QUICK BROWN FOX");
ok("count 'o'", tp.count("o"), 2);

print "";
print "=== Total ===";
print "Passed: " + passed;
print "Failed: " + failed;

if failed == 0 {
    print "ALL TESTS PASSED";
} else {
    print "SOME TESTS FAILED";
}
