# test_array_lib.jpx - Test untuk library/array.jpx (self-hosted)
# Assertion via output "PASS"/"FAIL" + "ALL TESTS PASSED" di akhir

[array];

global [passed = 0];
global [failed = 0];

function ok(name, actual, expected) {
    if actual == expected {
        global [passed = passed + 1];
        print "  PASS  " + name;
    } else {
        global [failed = failed + 1];
        print "  FAIL  " + name + " (expected " + expected + ", got " + actual + ")";
    }
}

print "=== array.first / last ===";
global [a = [10, 20, 30, 40, 50]];
ok("first", array.first(a), 10);
ok("last", array.last(a), 50);
ok("first empty", array.first([]), null);
ok("last empty", array.last([]), null);

print "";
print "=== array.contains / indexOf ===";
ok("contains 30", array.contains(a, 30), true);
ok("contains 99 (no)", array.contains(a, 99), false);
ok("indexOf 30", array.indexOf(a, 30), 2);
ok("indexOf 99 (no)", array.indexOf(a, 99), -1);

print "";
print "=== array.sum / max / min ===";
ok("sum", array.sum(a), 150);
ok("max", array.max(a), 50);
ok("min", array.min(a), 10);

print "";
print "=== array.join ===";
ok("join comma", array.join([1,2,3], ","), "1,2,3");
ok("join empty", array.join([], "-"), "");
ok("join space", array.join(["a","b","c"], " "), "a b c");

print "";
print "=== array.reverse ===";
ok("reverse", array.reverse([1,2,3,4]), [4,3,2,1]);
ok("reverse empty", array.reverse([]), []);
ok("reverse single", array.reverse([42]), [42]);

print "";
print "=== array.sort ===";
ok("sort ints", array.sort([3,1,4,1,5,9,2,6]), [1,1,2,3,4,5,6,9]);
ok("sort already", array.sort([1,2,3]), [1,2,3]);
ok("sort reverse", array.sort([5,4,3,2,1]), [1,2,3,4,5]);
ok("sort empty", array.sort([]), []);

print "";
print "=== array.push / pop ===";
ok("push", array.push([1,2,3], 4), [1,2,3,4]);
ok("push to empty", array.push([], 1), [1]);
ok("pop", array.pop([1,2,3]), [1,2]);
ok("pop empty", array.pop([]), []);

print "";
print "=== array.slice ===";
ok("slice 0:2", array.slice([1,2,3,4,5], 0, 2), [1,2]);
ok("slice 2:5", array.slice([1,2,3,4,5], 2, 5), [3,4,5]);

print "";
print "=== Total ===";
print "Passed: " + passed;
print "Failed: " + failed;

if failed == 0 {
    print "ALL TESTS PASSED";
} else {
    print "SOME TESTS FAILED";
}
