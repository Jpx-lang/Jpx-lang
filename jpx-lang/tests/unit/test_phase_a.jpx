# test_phase_a.jpx - Test semua fitur Phase A
# Menunjukkan: arr[i]=val, //, multiple assign, elif, string methods

global [passed = 0];
global [failed = 0];

function ok(name, actual, expected) {
    if actual == expected {
        global [passed = passed + 1];
        print "  PASS  " + name;
    } else {
        global [failed = failed + 1];
        print "  FAIL  " + name + " (expected " + expected + ", got " + actual + ")";
    }
}

print "=== Mutable List Assignment ===";
global [arr = [10, 20, 30, 40, 50]];
arr[0] = 99;
arr[2] = 77;
ok("arr[0] = 99", arr[0], 99);
ok("arr[2] = 77", arr[2], 77);
ok("arr unchanged others", arr[1], 20);

global [matrix = [[1, 2], [3, 4]]];
matrix[0][1] = 99;
ok("matrix[0][1] = 99", matrix[0][1], 99);

print "";
print "=== Integer Division // ===";
ok("17 // 5", 17 // 5, 3);
ok("10 // 3", 10 // 3, 3);
ok("100 // 7", 100 // 7, 14);
ok("7 // 2", 7 // 2, 3);
ok("10 // 4 (vs /)", 10 // 4, 2);

print "";
print "=== Multiple Assignment ===";
global [a = 1];
global [b = 2];
a, b = b, a;
ok("swap a", a, 2);
ok("swap b", b, 1);

global [x = 10];
global [y = 20];
global [z = 30];
x, y, z = 100, 200, 300;
ok("triple x", x, 100);
ok("triple y", y, 200);
ok("triple z", z, 300);

print "";
print "=== elif ===";
function grade(score) {
    if score >= 90 {
        return "A";
    } elif score >= 80 {
        return "B";
    } elif score >= 70 {
        return "C";
    } elif score >= 60 {
        return "D";
    } else {
        return "F";
    }
}
ok("grade 95", grade(95), "A");
ok("grade 85", grade(85), "B");
ok("grade 75", grade(75), "C");
ok("grade 65", grade(65), "D");
ok("grade 55", grade(55), "F");

print "";
print "=== String Methods ===";
global [s = "  Hello World  "];
ok("strip", s.strip(), "Hello World");
ok("upper", s.upper(), "  HELLO WORLD  ");
ok("lower", s.lower(), "  hello world  ");
ok("replace", s.replace("o", "0"), "  Hell0 W0rld  ");
ok("contains true", s.contains("World"), true);
ok("contains false", s.contains("xyz"), false);
ok("startsWith", s.startsWith("  He"), true);
ok("endsWith", s.endsWith("ld  "), true);

global [csv = "a,b,c,d"];
global [parts = csv.split(",")];
ok("split len", len(parts), 4);
ok("split[0]", parts[0], "a");
ok("split[3]", parts[3], "d");

ok("repeat", "ab".repeat(3), "ababab");
ok("find", "hello".find("l"), 2);
ok("count", "banana".count("a"), 3);
ok("substring 1 arg", "hello".substring(2), "llo");
ok("substring 2 args", "hello".substring(1, 4), "ell");

print "";
print "=== Combined Demo ===";
# Tokenize kalimat sederhana
global [text = "apple,banana,cherry,date"];
global [fruits = text.split(",")];
print "Fruits: " + fruits;
# Sort manual (bubble sort)
global [n = len(fruits)];
global [i = 0];
while i < n - 1 {
    global [j = 0];
    while j < n - 1 - i {
        if fruits[j] > fruits[j + 1] {
            global [tmp = fruits[j]];
            fruits[j] = fruits[j + 1];
            fruits[j + 1] = tmp;
        }
        global [j = j + 1];
    }
    global [i = i + 1];
}
print "Sorted: " + fruits;

print "";
print "=== Total ===";
print "Passed: " + passed;
print "Failed: " + failed;

if failed == 0 {
    print "ALL TESTS PASSED";
} else {
    print "SOME TESTS FAILED";
}
