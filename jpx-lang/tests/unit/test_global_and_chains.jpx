# test_global_and_chains.jpx - Regresi untuk perbaikan:
#   1. multi deklarasi `global [a = 1, b = 2, c = 3]`
#   2. rantai method string `s.upper().lower()`, `s.split(",")[0].upper()`
#   3. parameter function tidak boleh ketimpa global dengan nama sama

global [passed = 0];
global [failed = 0];

function ok(name, actual, expected) {
    if actual == expected {
        global [passed = passed + 1];
        print "  PASS  " + name;
    } else {
        global [failed = failed + 1];
        print "  FAIL  " + name + " (expected " + expected + ", got " + actual + ")";
    }
}

print "=== Multi Global Declaration ===";
global [m1 = 1, m2 = 2, m3 = 3];
ok("m1", m1, 1);
ok("m2", m2, 2);
ok("m3", m3, 3);

global [msg = "a,b,c", num = 42];
ok("comma inside string kept", msg, "a,b,c");
ok("num", num, 42);

global [list1 = [1, 2], list2 = [3, 4]];
ok("list1 len", len(list1), 2);
ok("list2 len", len(list2), 2);
ok("list1[0]", list1[0], 1);
ok("list2[1]", list2[1], 4);

global [person = {"name": "Alice", "age": 30}, flag = true];
ok("dict name", person.name, "Alice");
ok("dict age", person.age, 30);
ok("flag", flag, true);

# Pair dievaluasi berurutan: pair kedua boleh membaca pair pertama
global [seq1 = 10, seq2 = seq1 + 1];
ok("sequential first", seq1, 10);
ok("sequential reads first", seq2, 11);

# Bentuk single tetap jalan
global [only = 7];
ok("single global", only, 7);

print "";
print "=== Global Inside Function ===";
global [counter = 0];
function inc() {
    global [counter = counter + 1];
    return counter;
}
ok("inc 1", inc(), 1);
ok("inc 2", inc(), 2);
ok("inc 3", inc(), 3);

print "";
print "=== String Method Chaining ===";
global [word = "  Hello World  "];
ok("upper", word.upper(), "  HELLO WORLD  ");
ok("lower", word.lower(), "  hello world  ");
ok("upper().lower()", word.upper().lower(), "  hello world  ");
ok("lower().upper()", word.lower().upper(), "  HELLO WORLD  ");
ok("strip().upper()", word.strip().upper(), "HELLO WORLD");
ok("upper().strip().lower()", word.upper().strip().lower(), "hello world");
ok("replace().upper()", word.replace("o", "0").upper(), "  HELL0 W0RLD  ");
ok("literal chain", "abc".upper().lower(), "abc");
ok("trim alias", word.trim(), "Hello World");

global [csv = "alpha,beta,gamma"];
ok("split[0]", csv.split(",")[0], "alpha");
ok("split[0].upper()", csv.split(",")[0].upper(), "ALPHA");
ok("len(split[1])", len(csv.split(",")[1]), 4);

global [letters = ["x", "y"]];
ok("letters[0].upper()", letters[0].upper(), "X");

print "";
print "=== Parameter vs Global Name Collision ===";
# Sengaja bikin global `arr` yang bentrok dengan parameter array.sum(arr).
# Sebelumnya parameter ketimpa global -> index keluar batas.
global [arr = ["only", "two"]];
[array];
ok("array.sum with colliding global", array.sum([1, 2, 3]), 6);
ok("array.max with colliding global", array.max([5, 9, 2]), 9);
ok("array.min with colliding global", array.min([5, 9, 2]), 2);
ok("global arr untouched", len(arr), 2);
ok("global arr[0]", arr[0], "only");

print "";
print "=== Total ===";
print "Passed: " + passed;
print "Failed: " + failed;

if failed == 0 {
    print "ALL TESTS PASSED";
} else {
    print "SOME TESTS FAILED";
}
