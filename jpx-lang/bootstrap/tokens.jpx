# tokens.jpx - Token type definitions (self-hosted)

global [TOKEN_TYPES = {"NUMBER":"NUMBER","STRING":"STRING","IDENT":"IDENT","KEYWORD":"KEYWORD","OP":"OP","PUNCT":"PUNCT","NEWLINE":"NEWLINE","EOF":"EOF"}];

global [KEYWORDS = ["function","return","if","elif","else","while","for","in","to","break","continue","try","catch","global","import","class","true","false","null","and","or","not","is"]];

global [OPERATORS_3 = ["===","!==","...","<<=",">>="]];

global [OPERATORS_2 = ["==","!=","<=",">=","&&","||","+=","-=","*=","/=","%=","<<",">>","**","//","=>"]];

global [OPERATORS_1 = ["+","-","*","/","%","=","<",">","!","&","|","^","~"]];

global [PUNCTUATION = ["(",")","{","}","[","]",";",",",".","?",":"]];

function makeToken(type, value, line, col) {
    return [type, value, line, col];
}

function tokenType(token) {
    return token[0];
}

function tokenValue(token) {
    return token[1];
}

function tokenLine(token) {
    return token[2];
}

function tokenCol(token) {
    return token[3];
}

function isKeyword(word) {
    global [i = 0];
    while i < len(KEYWORDS) {
        if KEYWORDS[i] == word {
            return true;
        }
        global [i = i + 1];
    }
    return false;
}

function isPunctChar(c) {
    global [i = 0];
    while i < len(PUNCTUATION) {
        if PUNCTUATION[i] == c {
            return true;
        }
        global [i = i + 1];
    }
    return false;
}

function isDigit(c) {
    if c == "0" { return true; }
    if c == "1" { return true; }
    if c == "2" { return true; }
    if c == "3" { return true; }
    if c == "4" { return true; }
    if c == "5" { return true; }
    if c == "6" { return true; }
    if c == "7" { return true; }
    if c == "8" { return true; }
    if c == "9" { return true; }
    return false;
}

function isAlpha(c) {
    global [code = ord(c)];
    if code >= 65 {
        if code <= 90 { return true; }
    }
    if code >= 97 {
        if code <= 122 { return true; }
    }
    if code == 95 { return true; }
    return false;
}

function isAlphaNum(c) {
    if isAlpha(c) { return true; }
    if isDigit(c) { return true; }
    return false;
}

function isSpace(c) {
    if c == " " { return true; }
    if c == "\t" { return true; }
    if c == "\r" { return true; }
    return false;
}

function tokenToString(token) {
    global [t = token[0]];
    global [v = token[1]];
    global [l = token[2]];
    if v == null {
        return "Token(" + t + ", null, line=" + l + ")";
    }
    return "Token(" + t + ", " + v + ", line=" + l + ")";
}
