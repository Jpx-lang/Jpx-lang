# array.jpx - Array utility library (ditulis dalam JPX sendiri)
# Self-hosted library! Tidak ada Python di sini.
#
# Usage:
#   [array];
#   global [a = [3, 1, 4, 1, 5, 9, 2, 6]];
#   print array.sort(a);         # [1, 1, 2, 3, 4, 5, 6, 9]
#   print array.reverse(a);      # [6, 2, 9, 5, 1, 4, 1, 3]
#   print array.sum(a);          # 31
#   print array.contains(a, 5);  # true

# ============================================================
# BASIC OPERATIONS
# ============================================================

function push(arr, item) {
    # Append item ke akhir array (return new array — immutable style)
    global [result = []];
    global [i = 0];
    while i < len(arr) {
        global [result = result + [arr[i]]];
        global [i = i + 1];
    }
    global [result = result + [item]];
    return result;
}

function pop(arr) {
    # Return array tanpa elemen terakhir
    if len(arr) == 0 {
        return [];
    }
    global [result = []];
    global [i = 0];
    while i < len(arr) - 1 {
        global [result = result + [arr[i]]];
        global [i = i + 1];
    }
    return result;
}

function first(arr) {
    if len(arr) == 0 {
        return null;
    }
    return arr[0];
}

function last(arr) {
    if len(arr) == 0 {
        return null;
    }
    return arr[len(arr) - 1];
}

# ============================================================
# SEARCH
# ============================================================

function contains(arr, item) {
    global [i = 0];
    while i < len(arr) {
        if arr[i] == item {
            return true;
        }
        global [i = i + 1];
    }
    return false;
}

function indexOf(arr, item) {
    global [i = 0];
    while i < len(arr) {
        if arr[i] == item {
            return i;
        }
        global [i = i + 1];
    }
    return -1;
}

function count(arr, item) {
    global [c = 0];
    global [i = 0];
    while i < len(arr) {
        if arr[i] == item {
            global [c = c + 1];
        }
        global [i = i + 1];
    }
    return c;
}

# ============================================================
# TRANSFORM
# ============================================================

function reverse(arr) {
    global [result = []];
    global [i = len(arr) - 1];
    while i >= 0 {
        global [result = result + [arr[i]]];
        global [i = i - 1];
    }
    return result;
}

# Bubble sort (simple, no built-in sort di JPX)
function sort(arr) {
    # Copy dulu
    global [result = []];
    global [i = 0];
    while i < len(arr) {
        global [result = result + [arr[i]]];
        global [i = i + 1];
    }
    # Bubble sort
    global [n = len(result)];
    global [i = 0];
    while i < n - 1 {
        global [j = 0];
        while j < n - 1 - i {
            if result[j] > result[j + 1] {
                # Swap
                global [tmp = result[j]];
                # Build new array dengan swap
                global [newArr = []];
                global [k = 0];
                while k < len(result) {
                    if k == j {
                        global [newArr = newArr + [result[j + 1]]];
                    } else {
                        if k == j + 1 {
                            global [newArr = newArr + [tmp]];
                        } else {
                            global [newArr = newArr + [result[k]]];
                        }
                    }
                    global [k = k + 1];
                }
                global [result = newArr];
            }
            global [j = j + 1];
        }
        global [i = i + 1];
    }
    return result;
}

function sum(arr) {
    global [total = 0];
    global [i = 0];
    while i < len(arr) {
        global [total = total + arr[i]];
        global [i = i + 1];
    }
    return total;
}

function max(arr) {
    if len(arr) == 0 {
        return null;
    }
    global [m = arr[0]];
    global [i = 1];
    while i < len(arr) {
        if arr[i] > m {
            global [m = arr[i]];
        }
        global [i = i + 1];
    }
    return m;
}

function min(arr) {
    if len(arr) == 0 {
        return null;
    }
    global [m = arr[0]];
    global [i = 1];
    while i < len(arr) {
        if arr[i] < m {
            global [m = arr[i]];
        }
        global [i = i + 1];
    }
    return m;
}

function join(arr, glue) {
    if len(arr) == 0 {
        return "";
    }
    global [result = str(arr[0])];
    global [i = 1];
    while i < len(arr) {
        global [result = result + glue + str(arr[i])];
        global [i = i + 1];
    }
    return result;
}

function slice(arr, start, end) {
    global [result = []];
    if start < 0 {
        global [start = 0];
    }
    if end > len(arr) {
        global [end = len(arr)];
    }
    global [i = start];
    while i < end {
        global [result = result + [arr[i]]];
        global [i = i + 1];
    }
    return result;
}

# ============================================================
# EXPORTS
# ============================================================
# Di modul .jpx, semua top-level function otomatis di-expose
# oleh _load_jpx_module di importer.py. Tidak perlu deklarasi eksplisit.
