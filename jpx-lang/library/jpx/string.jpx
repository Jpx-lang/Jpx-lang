# jpx/string.jpx - String utilities (self-hosted)
#
# Usage:
#   [jpx.string];
#   print string.upper("hello");
#   print string.split("a,b,c", ",");

function length(s) {
    if s is null { return 0; }
    return len(s);
}

function upper(s) {
    if s is null { return ""; }
    return s.upper();
}

function lower(s) {
    if s is null { return ""; }
    return s.lower();
}

function trim(s) {
    if s is null { return ""; }
    return s.strip();
}

function reverse(s) {
    if s is null { return ""; }
    global [result = ""];
    global [i = len(s) - 1];
    while i >= 0 {
        result = result + s[i];
        i = i - 1;
    }
    return result;
}

function contains(s, sub) {
    if s is null { return false; }
    if sub is null { return false; }
    return sub in s;
}

function replace(s, old, new) {
    if s is null { return ""; }
    return s.replace(old, new);
}

function split(s, delim) {
    if s is null { return []; }
    if delim is null { return [s]; }
    return s.split(delim);
}

function join(arr, glue) {
    if arr is null { return ""; }
    if glue is null { glue = ""; }
    global [result = ""];
    global [i = 0];
    while i < len(arr) {
        if i > 0 {
            result = result + glue;
        }
        result = result + str(arr[i]);
        i = i + 1;
    }
    return result;
}

function startsWith(s, prefix) {
    if s is null { return false; }
    return s.startsWith(prefix);
}

function endsWith(s, suffix) {
    if s is null { return false; }
    return s.endsWith(suffix);
}

function find(s, sub) {
    if s is null { return -1; }
    return s.find(sub);
}

function count(s, sub) {
    if s is null { return 0; }
    return s.count(sub);
}

function repeat(s, n) {
    if s is null { return ""; }
    return s.repeat(n);
}

function substring(s, start, end) {
    if s is null { return ""; }
    if end is null {
        return s[start:];
    }
    return s[start:end];
}

function isDigit(s) {
    if s is null { return false; }
    if len(s) == 0 { return false; }
    global [i = 0];
    while i < len(s) {
        global [c = s[i]];
        global [code = ord(c);
        if code < 48 { return false; }
        if code > 57 { return false; }
        i = i + 1;
    }
    return true;
}

function isAlpha(s) {
    if s is null { return false; }
    if len(s) == 0 { return false; }
    global [i = 0];
    while i < len(s) {
        global [c = s[i]];
        global [code = ord(c);
        if code >= 65 {
            if code <= 90 {
                i = i + 1;
                continue;
            }
        }
        if code >= 97 {
            if code <= 122 {
                i = i + 1;
                continue;
            }
        }
        return false;
    }
    return true;
}

function toCharArray(s) {
    if s is null { return []; }
    global [result = []];
    global [i = 0];
    while i < len(s) {
        result = result + [s[i]];
        i = i + 1;
    }
    return result;
}

function fromCharArray(arr) {
    if arr is null { return ""; }
    global [result = ""];
    global [i = 0];
    while i < len(arr) {
        result = result + str(arr[i]);
        i = i + 1;
    }
    return result;
}
