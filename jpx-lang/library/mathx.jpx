# mathx.jpx - Extended math library (self-hosted)
# Usage: [mathx]; print mathx.fib(10);

function fib(n) {
    if n <= 0 { return 0; }
    if n == 1 { return 1; }
    a = 0;
    b = 1;
    i = 2;
    while i <= n {
        c = a + b;
        a = b;
        b = c;
        i = i + 1;
    }
    return b;
}

function factorial(n) {
    if n <= 1 { return 1; }
    result = 1;
    i = 2;
    while i <= n {
        result = result * i;
        i = i + 1;
    }
    return result;
}

function isPrime(n) {
    if n < 2 { return false; }
    if n == 2 { return true; }
    if n % 2 == 0 { return false; }
    i = 3;
    while i * i <= n {
        if n % i == 0 { return false; }
        i = i + 2;
    }
    return true;
}

function gcd(a, b) {
    while b != 0 {
        t = b;
        b = a % b;
        a = t;
    }
    return a;
}

function lcm(a, b) {
    if a == 0 { return 0; }
    if b == 0 { return 0; }
    return (a * b) / gcd(a, b);
}

function power(base, exp) {
    if exp == 0 { return 1; }
    if exp < 0 { return 1 / power(base, 0 - exp); }
    result = 1;
    i = 0;
    while i < exp {
        result = result * base;
        i = i + 1;
    }
    return result;
}

function isqrt(n) {
    if n < 0 { return 0; }
    if n == 0 { return 0; }
    x = n;
    y = int((x + 1) / 2);
    while y < x {
        x = y;
        y = int((x + n / x) / 2);
    }
    return x;
}

function mean(arr) {
    if len(arr) == 0 { return 0; }
    total = 0;
    i = 0;
    while i < len(arr) {
        total = total + arr[i];
        i = i + 1;
    }
    return total / len(arr);
}

function median(arr) {
    if len(arr) == 0 { return 0; }
    n = len(arr);
    if n % 2 == 1 {
        return arr[n / 2];
    }
    return (arr[n / 2 - 1] + arr[n / 2]) / 2;
}
