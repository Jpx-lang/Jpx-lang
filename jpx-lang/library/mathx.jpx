# mathx.jpx - Extended math library (ditulis dalam JPX sendiri)
# Math functions yang TIDAK ada di built-in math.py
#
# Usage:
#   [mathx];
#   print mathx.fib(10);       # 55
#   print mathx.factorial(5);  # 120
#   print mathx.isPrime(17);   # true
#   print mathx.gcd(12, 18);   # 6

# ============================================================
# SEQUENCES
# ============================================================

function fib(n) {
    if n <= 0 {
        return 0;
    }
    if n == 1 {
        return 1;
    }
    global [a = 0];
    global [b = 1];
    global [i = 2];
    while i <= n {
        global [c = a + b];
        global [a = b];
        global [b = c];
        global [i = i + 1];
    }
    return b;
}

function factorial(n) {
    if n <= 1 {
        return 1;
    }
    global [result = 1];
    global [i = 2];
    while i <= n {
        global [result = result * i];
        global [i = i + 1];
    }
    return result;
}

# ============================================================
# NUMBER THEORY
# ============================================================

function isPrime(n) {
    if n < 2 {
        return false;
    }
    if n == 2 {
        return true;
    }
    if n % 2 == 0 {
        return false;
    }
    global [i = 3];
    while i * i <= n {
        if n % i == 0 {
            return false;
        }
        global [i = i + 2];
    }
    return true;
}

function gcd(a, b) {
    while b != 0 {
        global [t = b];
        global [b = a % b];
        global [a = t];
    }
    return a;
}

function lcm(a, b) {
    if a == 0 or b == 0 {
        return 0;
    }
    return (a * b) / gcd(a, b);
}

# ============================================================
# POWER & ROOTS
# ============================================================

function power(base, exp) {
    if exp == 0 {
        return 1;
    }
    if exp < 0 {
        return 1 / power(base, 0 - exp);
    }
    global [result = 1];
    global [i = 0];
    while i < exp {
        global [result = result * base];
        global [i = i + 1];
    }
    return result;
}

function isqrt(n) {
    # Integer square root via Newton's method
    if n < 0 {
        return 0;
    }
    if n == 0 {
        return 0;
    }
    global [x = n];
    global [y = int((x + 1) / 2)];
    while y < x {
        global [x = y];
        global [y = int((x + n / x) / 2)];
    }
    return x;
}

# ============================================================
# STATISTICS
# ============================================================

function mean(arr) {
    if len(arr) == 0 {
        return 0;
    }
    global [total = 0];
    global [i = 0];
    while i < len(arr) {
        global [total = total + arr[i]];
        global [i = i + 1];
    }
    return total / len(arr);
}

function median(arr) {
    if len(arr) == 0 {
        return 0;
    }
    # Note: ini implementasi sederhana, tidak sort (sort ada di array.jpx)
    # User harus sort dulu sebelum panggil median
    global [n = len(arr)];
    if n % 2 == 1 {
        return arr[n / 2];
    }
    return (arr[n / 2 - 1] + arr[n / 2]) / 2;
}
